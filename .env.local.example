# Supabase - Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key   # requerida para el correo de confirmacion del alumno
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Secreto para firmar la cookie de sesion (cualquier cadena larga)
AUTH_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# Rate limiting de /api/* (src/middleware.ts). Poner en 1 solo para desactivarlo en pruebas.
# RATE_LIMIT_DESACTIVADO=0

# --- Confirmacion de correo de alumnos (Supabase Auth) ---
# ALUMNOS_CONFIRMAN_CORREO=true  -> al registrarse se envia un correo de confirmacion.
# ALUMNOS_CONFIRMAN_CORREO=false -> no se envia correo; solo el admin acepta al alumno.
ALUMNOS_CONFIRMAN_CORREO=true
#
# Para que el correo funcione bien, en el panel de Supabase:
#  1. Authentication > Providers > Email  ->  "Confirm email" = ON
#  2. Authentication > URL Configuration  ->  agrega a "Redirect URLs":
#       http://localhost:3000/**   y   https://TU-DOMINIO/**
#  3. Authentication > Emails > SMTP Settings  ->  configura un SMTP propio
#     (Resend, SendGrid, Brevo, Gmail...). El correo integrado de Supabase solo
#     envia ~2 por hora y solo a miembros del proyecto.
